#!/usr/bin/env bash
#
# Package a Factorio mod for upload to the mod portal.
#
# Zips the mod into dist/<mod-name>_<version>.zip with the portal-required
# layout (root folder "<name>_<version>") and excludes development-only
# files (tests/, tools/, dotfiles, backups).
#
# Usage:
#   ./tools/package-mod          # package the mod carrying this script
#   ./tools/package-mod <mod>    # package a sibling mod under factorio/mods/
#
# Requires: zip, unzip (listing), grep -P
set -euo pipefail

MOD_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MODS_DIR="$(dirname "$MOD_DIR")"
REPO_ROOT="$(cd "$MOD_DIR/../../.." && pwd)"
OUT_DIR="$REPO_ROOT/dist"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '2,12p' "$0"; exit 0
fi
[[ $# -gt 1 ]] && { echo "error: too many arguments (try --help)" >&2; exit 2; }

MOD="${1:-$(basename "$MOD_DIR")}"
SRC_DIR="$MODS_DIR/$MOD"
[[ -d "$SRC_DIR" ]] || { echo "error: no such mod directory: $SRC_DIR" >&2; exit 1; }
[[ -f "$SRC_DIR/info.json" ]] || { echo "error: $SRC_DIR has no info.json" >&2; exit 1; }

# Fields are one-per-line in our info.json; grep suffices, no JSON parser needed.
json_field() {
    local field="$1"
    grep -oP '"'$field'"\s*:\s*"\K[^"]+' "$SRC_DIR/info.json" | head -n1
}
NAME="$(json_field name)"
VERSION="$(json_field version)"
[[ -n "$NAME" && -n "$VERSION" ]] || {
    echo "error: could not read name/version from $SRC_DIR/info.json" >&2; exit 1;
}

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
PKG="$STAGE/${NAME}_${VERSION}"
mkdir -p "$PKG"

# Copy everything, then drop dev-only files; keep locale/ and any assets.
cp -a "$SRC_DIR/." "$PKG/"
rm -rf \
    "$PKG/tests" \
    "$PKG/tools" \
    "$PKG"/*.html \
    "$PKG"/.git* \
    "$PKG"/*.bak \
    "$PKG"/*.orig \
    "$PKG"/*.swp

mkdir -p "$OUT_DIR"
ZIP="$OUT_DIR/${NAME}_${VERSION}.zip"
rm -f "$ZIP"
(cd "$STAGE" && zip -qr "$ZIP" "${NAME}_${VERSION}")

echo "packaged $MOD $VERSION -> $ZIP"
unzip -l "$ZIP"
