#!/usr/bin/env python3
"""Talk to a running Factorio server over RCON.

    tools/rcon "/players"
    tools/rcon "/c game.surfaces[1].count_entities_filtered{type='turret'}"
    tools/rcon --lua "game.tick"          # eval Lua, pcall-wrapped, result in the log

Factorio speaks the Source RCON protocol, so this is ~40 lines of stdlib
rather than a pip dependency. Host/port/password come from the
environment (RCON_HOST, RCON_PORT, RCON_PASSWORD) or the defaults below.

A bad Lua snippet fails silently on the server side, so Lua evals are
wrapped in pcall and any runtime error is written to the server log with
the PROBE-ERROR marker. (The control stage has no load(), so a syntax
error in the snippet is still silent -- read results back from the log.)
"""

import os
import socket
import struct
import sys

HOST = os.environ.get("RCON_HOST", "localhost")
PORT = int(os.environ.get("RCON_PORT", "27015"))
PASSWORD = os.environ.get("RCON_PASSWORD", "12345")


def pack(req_id, req_type, body):
    payload = struct.pack("<ii", req_id, req_type) + body.encode("utf8") + b"\x00\x00"
    return struct.pack("<i", len(payload)) + payload


def read_exact(sock, count):
    buf = b""
    while len(buf) < count:
        chunk = sock.recv(count - len(buf))
        if not chunk:
            raise EOFError
        buf += chunk
    return buf


def read_packet(sock):
    (length,) = struct.unpack("<i", read_exact(sock, 4))
    payload = read_exact(sock, length)
    req_id, req_type = struct.unpack("<ii", payload[:8])
    return req_id, req_type, payload[8:-2].decode("utf8", "replace")


def main(command):
    with socket.create_connection((HOST, PORT), timeout=10) as sock:
        sock.settimeout(2)
        sock.sendall(pack(1, 3, PASSWORD))          # SERVERDATA_AUTH
        while True:
            req_id, req_type, _ = read_packet(sock)
            if req_id == -1:
                sys.exit("auth failed (wrong password?)")
            if req_type == 2:                      # SERVERDATA_AUTH_RESPONSE
                break
        sock.sendall(pack(2, 2, command))          # SERVERDATA_EXECCOMMAND
        out = []
        while True:
            # The server sends one packet per command and then nothing.
            try:
                req_id, req_type, body = read_packet(sock)
            except (socket.timeout, EOFError):
                break
            if req_type == 0 and not body:
                break
            out.append(body)
        print("\n".join(out) or "(no output)")


def lua(body):
    # A broken snippet vanishes silently on the server side, so wrap the
    # eval in pcall and report runtime errors. Note: Factorio's control stage
    # has no load(), so a *syntax* error still fails silently -- and log()
    # is the only channel that carries the result back.
    wrapped = ("local ok, err = pcall(function() %s end); "
               "if not ok then log('PROBE-ERROR ' .. tostring(err)) end" % body)
    return main("/c " + wrapped)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    args = sys.argv[1:]
    if args[0] == "--lua":
        if len(args) < 2:
            sys.exit("usage: rcon --lua '<lua expression or statements>'")
        lua(" ".join(args[1:]))
    else:
        main(" ".join(args))
