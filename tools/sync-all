#!/usr/bin/env bash
#
# Push all repo-tracked server state to the live install in one command.
#
# Runs, in dependency order:
#   1. tools/sync-mod-list       enabled mod set from factorio/data/mods.json
#   2. tools/sync-mod-settings apply  startup settings from factorio/data/mod-settings.json
#   3. tools/sync-save  scenario Lua into the save zip(s)
#
#   tools/sync-all [--save PATH]... [--dat PATH] [--mods-dir DIR] [--check] [--force]
#
#   --save PATH   save zip to refresh (repeatable; default: /factorio/saves/legdeath.zip)
#   --dat PATH    mod-settings.dat to update (default: the sync-mod-settings default)
#   --mods-dir D  mods directory (default: the sync-mod-list default)
#   --check       dry run: report drift across all three steps, change nothing
#   --force       run while the Factorio server is up (the scripts also guard;
#                 updating the save zip under a running server means its next
#                 save overwrites your changes -- stop the server first)
#
# Requires: bash, jq (plus python3/curl for the mod-settings step)
set -euo pipefail
cd "$(dirname "$0")/.."
TMPDIR_WORK="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_WORK"' EXIT

usage() {
    sed -n '2,20p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
}

SAVES=()
CHECK=0
FORCE=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --save) SAVES+=("$2"); shift 2 ;;
        --dat) export MOD_SETTINGS_DAT="$2"; shift 2 ;;
        --mods-dir) export MODS_DIR="$2"; shift 2 ;;
        --check) CHECK=1; shift ;;
        --force|-f) FORCE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "error: unknown argument: $1 (try --help)" >&2; exit 2 ;;
    esac
done
if (( ${#SAVES[@]} == 0 )); then
    if [[ -f /factorio/saves/legdeath.zip ]]; then
        SAVES=(/factorio/saves/legdeath.zip)
    else
        echo "error: no --save given and /factorio/saves/legdeath.zip not found" >&2
        exit 2
    fi
fi

if pgrep -x factorio >/dev/null 2>&1; then
    if (( FORCE )); then
        echo "warning: factorio is running; continuing anyway (--force)." >&2
    else
        echo "error: a factorio process appears to be running; stop the server first (or --force)." >&2
        exit 1
    fi
fi

DRIFT=0

echo "== 1/3 mod list ==" >&2
if (( CHECK )); then
    ./tools/sync-mod-list --check || DRIFT=1
else
    ./tools/sync-mod-list
fi

echo "== 2/3 mod settings ==" >&2
if (( CHECK )); then
    DIFF_OUT="$(./tools/sync-mod-settings diff)"
    if [[ -n "$DIFF_OUT" ]]; then
        echo "$DIFF_OUT"
        DRIFT=1
    else
        echo "check: startup settings match" >&2
    fi
else
    ./tools/sync-mod-settings apply
fi

echo "== 3/3 scenario lua (${SAVES[*]}) ==" >&2
LUA_ARGS=()
(( CHECK )) && LUA_ARGS+=(--dry-run)
(( FORCE )) && LUA_ARGS+=(--force)
if (( CHECK )); then
    ./tools/sync-save "${LUA_ARGS[@]}" "${SAVES[@]}" >"$TMPDIR_WORK/lua-dry-run.txt" 2>&1
    cat "$TMPDIR_WORK/lua-dry-run.txt"
    grep -q "would update" "$TMPDIR_WORK/lua-dry-run.txt" && DRIFT=1
else
    ./tools/sync-save "${LUA_ARGS[@]}" "${SAVES[@]}"
fi

if (( CHECK )); then
    if (( DRIFT )); then
        echo "check: drift detected (see above)" >&2
        exit 1
    fi
    echo "check: everything up to date" >&2
fi
